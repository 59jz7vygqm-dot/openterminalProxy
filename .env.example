# ---------------------------------------------------------------------------
# openterminal-proxy -- copy to .env next to docker-compose.openterminal.yml
# ---------------------------------------------------------------------------

# The key Open WebUI sends as its bearer token. Generate one, do not invent one:
#   openssl rand -base64 36
OTPROXY_API_KEY=

# Separate key for /api/v1/status, /api/v1/terminals and /metrics.
# Leave empty to keep the admin API switched off entirely.
OTPROXY_ADMIN_KEY=

# The group that owns /var/run/docker.sock on the host, so the proxy container
# can reach the daemon without running as root:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# --- the sandbox image ------------------------------------------------------
# The full image (~4 GB) carries python, numpy/pandas/scipy, gcc and the rest,
# which is what makes it useful for computing. The slim image is ~430 MB and
# brings almost none of it -- see the README for the capability settings it needs.
OTPROXY_IMAGE=ghcr.io/open-webui/open-terminal:latest

# --- how much one user may use ---------------------------------------------
OTPROXY_MEMORY=2g
OTPROXY_CPUS=1.0
OTPROXY_PIDS_LIMIT=512
OTPROXY_TMPFS_SIZE=512m

# --- how many at once, and for how long ------------------------------------
OTPROXY_MAX_SANDBOXES=50
OTPROXY_POOL_SIZE=1
OTPROXY_IDLE_TIMEOUT=900
OTPROXY_MAX_LIFETIME=86400

# --- networking -------------------------------------------------------------
# One internal /29 per user is carved out of this range. It must not overlap
# anything the host routes, and it is the range the host firewall rule covers.
OTPROXY_NET_SUPERNET=10.88.0.0/16

# --- keep the home directory between sessions (off = nothing survives) ------
OTPROXY_PERSIST_HOME=false

# --- handing files to the user ----------------------------------------------
# The address the USER'S BROWSER can reach this proxy at. Setting it adds a
# share_file tool: the model turns a file in its workspace into a signed,
# short-lived link and pastes it into its answer. Needed for any connection
# type other than Open Terminal, which is the only one whose own file preview
# can reach the sandbox. Leave empty to not offer it at all.
# OTPROXY_PUBLIC_URL=http://172.16.3.50:8800
# OTPROXY_DOWNLOAD_TTL=600

# --- what the user sees of the terminal -------------------------------------
# Hide Open WebUI's terminal panel (changes only what the proxy reports, so the
# sandbox and the in-chat file preview keep working), keep the ports list empty,
# and point the file browser at a deliverables folder. The proxy creates that
# folder in every new sandbox.
# OTPROXY_UI_FEATURES={"terminal":false}
# OTPROXY_HIDE_PORTS=true

# --- extra environment for every sandbox ------------------------------------
# One JSON object, so everything for the sandbox goes in here together:
#   OPEN_TERMINAL_FILE_BROWSER_ROOT  what the file browser may show
#   OPEN_TERMINAL_ENABLE_TERMINAL    "false" removes the shell routes outright,
#                                    stricter than UI_FEATURES and able to
#                                    switch off more than intended
#   OPEN_TERMINAL_ENABLE_NOTEBOOKS   "false" if notebooks are not wanted
# OTPROXY_SANDBOX_ENV={"OPEN_TERMINAL_FILE_BROWSER_ROOT":"/home/user/public"}

# ---------------------------------------------------------------------------
# Telemetrie an aimonitor -- aus, solange AIMON_URL leer ist
# ---------------------------------------------------------------------------
# AIMON_URL=http://aimon.lan:8420
# AIMON_TOKEN=
# AIMON_NODE=proxy-host-01
# AIMON_SERVICE_KEY=openterminal-proxy@proxy-host-01:8800
# AIMON_INTERVAL=10
# AIMON_BUFFER_SECONDS=600
